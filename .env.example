# ── new-api-key-usage · 本地环境变量示例 ──────────────────────────
# 复制为 .env 后填写（.env 已被 .gitignore，勿提交）

# 本服务端口（避开 3000/3001 等常见占用）
PORT=18456

# PostgreSQL 连接串（开发 compose 默认如下）
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/new_api_key_usage

# 已登记 sk-key 的加密密钥：≥32 字节随机数，base64url。
# 生成示例（PowerShell）：
#   $r=[Security.Cryptography.RandomNumberGenerator]::Create();$b=New-Object byte[] 32;$r.GetBytes($b);[Convert]::ToBase64String($b)
# ⚠ 入库后不可更换；丢失 = 存量 key_ciphertext 无法解密。与库同等备份。
SK_KEY_ENCRYPTION_SECRET=

# 上游 NewAPI 实例根地址（不是本服务）
NEWAPI_BASE=http://127.0.0.1:8080

# 会话 cookie 是否带 Secure（默认 true）。
# 本地 http://localhost 或 127.0.0.1 调试：现代浏览器可保留 true；
# 局域网 IP / 自定义域名 / 出现「登录后立刻 401」时改为 false。
COOKIE_SECURE=false

# 业务日志级别：debug | info | warning | error | fatal（访问日志另由 hono/logger 输出）
LOG_LEVEL=info

# 空库双通道：可选。用户名与密码同时存在时，首次 setup-state 静默落库；
# 只填一个视为未配置。此后改 env 不改密；改密走管理面表单。
# ADMIN_INIT_USERNAME=
# ADMIN_INIT_PASSWORD=
