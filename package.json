{
  "name": "new-api-key-usage",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev:server": "bun --hot --env-file=.env apps/server/src/index.ts",
    "dev:engine": "bun --env-file=.env apps/engine/src/index.ts",
    "dev:web": "bun run --cwd apps/web dev",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:push": "bun run --cwd packages/db db:push",
    "db:studio": "bun run --cwd packages/db db:studio",
    "build:web": "bun run --cwd apps/web build"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
